{
  "name": "cv-creator",
  "version": "1.0.1",
  "description": "Build a PDF CV from JSON data, with live preview and an API",
  "license": "MIT",
  "author": "",
  "type": "module",
  "bin": {
    "cv-creator-mcp": "src/mcp.js"
  },
  "scripts": {
    "dev": "node src/server.js",
    "build": "node src/build.js",
    "build:all": "node src/build.js --all",
    "validate": "node src/validate.js",
    "prepare": "husky || echo 'husky skipped'",
    "mcp": "node src/mcp.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@fontsource/dm-sans": "^5.3.0",
    "@lwojcik/eslint-config": "^0.2.0",
    "husky": "^9.1.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ajv": "^8.20.0",
    "pdfjs-dist": "^6.5.438",
    "puppeteer": "^25.18.1",
    "zod": "^4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
